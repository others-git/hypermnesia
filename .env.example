# Copy to .env and adjust.

HM_DATABASE_URL=postgresql://hypermnesia:hypermnesia@localhost:5432/hypermnesia

# Embeddings (local / CPU). provider: fastembed | sentence_transformers | ollama
HM_EMBEDDING_PROVIDER=fastembed
HM_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# HM_EMBEDDING_DIM=384            # optional; auto-detected from the model
# HM_OLLAMA_BASE_URL=http://localhost:11434

# Recall / write behaviour
HM_DEDUPE_THRESHOLD=0.92
HM_DEFAULT_TOP_K=8
# Drop search hits below this cosine similarity (0.0 disables). Default tuned for
# bge-small-en-v1.5, whose cosine range is compressed (unrelated ~0.30-0.45,
# relevant ~0.55+); re-tune if you change embedding models.
HM_SEARCH_MIN_SIMILARITY=0.4
# Relative gate: drop hits more than this far below the best hit of the same
# search. This is what keeps a good answer from arriving buried in near-misses —
# an absolute floor can't, because unrelated text scores well inside every
# model's cosine range. Unlike the floor above it travels across models. 0 = off.
HM_SEARCH_RELATIVE_CUTOFF=0.15
# Ranking blend: score = w_sim*similarity + w_recency*recency + w_importance*importance
HM_SCORE_WEIGHT_SIMILARITY=1.0
# Keep these small relative to how much similarity actually VARIES across a
# candidate set (~0.18 for bge-small, whose cosine range is compressed), or a
# stale-but-important memory outranks the one that answers the query.
HM_SCORE_WEIGHT_RECENCY=0.10
HM_SCORE_WEIGHT_IMPORTANCE=0.06
HM_RECENCY_HALF_LIFE_DAYS=30
HM_IMPORTANCE_CAP=2.0
HM_RERANK_CANDIDATE_MULTIPLIER=5
# Hybrid search: run a lexical (Postgres full-text) query alongside the semantic
# one so exact tokens aren't lost to the embedding. Relevance stays the cosine
# similarity; a lexical match adds at most HM_HYBRID_LEXICAL_BOOST on top,
# decaying with its lexical rank. Not reciprocal-rank fusion — RRF discards the
# magnitude of a semantic match, which is the only thing that separates the
# memory that answers a question from one that merely shares its wording.
HM_HYBRID_SEARCH=true
HM_HYBRID_LEXICAL_BOOST=0.10
HM_HYBRID_RANK_DECAY_K=60

# Forgetting: memory_forget archives memories not recalled in this many days whose
# importance is at or below the floor. Recall and higher importance keep them alive.
HM_FORGET_AFTER_DAYS=180
HM_FORGET_IMPORTANCE_FLOOR=1.0

# Server
HM_HOST=127.0.0.1
HM_PORT=8765
# Without this nothing configures logging, so the forget sweep's report and the
# warning about falling back to the shared `default` scope go nowhere.
HM_LOG_LEVEL=INFO

# Auth: map bearer tokens to a principal and the scopes it may read/write.
HM_REQUIRE_AUTH=true
HM_AUTH_TOKENS={"dev-token":{"principal":"dev","scopes":["default","shared","user:dev-test"]}}
